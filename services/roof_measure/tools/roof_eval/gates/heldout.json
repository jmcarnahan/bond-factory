   "where": [
    "facet_count_src=vision_label,vendor,manual"
   ]
  },
  {
   "name": "3i mergeable neighbour share: median <= 0.02",
   "metric": "mergeable_neighbour_share",
   "agg": "median",
   "op": "<=",
   "value": 0.02,
   "require": [
    "automation_ok"
   ],
   "min_n": 10
  },
  {
   "name": "3j mergeable neighbour share: p90 <= 0.08",
   "metric": "mergeable_neighbour_share",
   "agg": "p90",
   "op": "<=",
   "value": 0.08,
   "require": [
    "automation_ok"
   ],
   "min_n": 10
  },
  {
   "name": "3k unsupported facet area share: median <= 0.08",
   "metric": "unsupported_facet_area_share",
   "agg": "median",
   "op": "<=",
   "value": 0.08,
   "require": [
    "automation_ok"
   ],
   "min_n": 10
  },
  {
   "name": "3l false + unmarked level changes pooled <= 2.5% of edge length",
   "metric": "false_unmarked_ft",
   "agg": "ratio",
   "op": "<=",
   "value": 0.025,
   "require": [
    "automation_ok"
   ],
   "denominator": "edge_len_ft",
   "min_n": 10
  },
  {
   "name": "5 invalid or crashed results = 0",
   "metric": "invalid_or_crashed",
   "agg": "sum",
   "op": "==",
   "value": 0
  },
  {
   "name": "7a T3: 90% interval of the median ratio contains 1.00",
   "agg": "t3_contains",
   "op": ">=",
   "value": 1.0,
   "require": [
    "automation_ok"
   ],
   "min_n": 10
  },
  {
   "name": "7b T3: ratio IQR <= 1.35 x the library baseline's",
   "agg": "t3_iqr_ratio",
   "op": "<=",
   "value": 1.35,
   "require": [
    "automation_ok"
   ],
   "baseline": "library-0.4.0",
   "min_n": 10
  },
  {
   "name": "6 T2: mean two-sided facet IoU >= 0.60 (>= 10 labelled houses)",
   "metric": "truth.T2.facet_iou.mean_iou",
   "agg": "mean",
   "op": ">=",
   "value": 0.6,
   "require": [
    "automation_ok"
   ],
   "where": [
    "tiers=T2"
   ],
   "min_n": 10,
   "on_insufficient": "fail"
  }
 ]
}
