#!/usr/bin/env bash
# Public-hygiene check before every commit. Installed by `make hooks` (sets core.hooksPath to .githooks).
# Fast: tracked files only, no network. CI runs the same script through `make gates`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
bash tool/public_hygiene.sh || {
  echo "pre-commit: public hygiene failed; fix the files above or add an exemption to tool/allowlist_hygiene.txt" >&2
  exit 1
}
